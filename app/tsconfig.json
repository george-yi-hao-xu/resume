{
    "compilerOptions": {
        "allowJs": false,
        "isolatedModules": true,
        "lib": ["DOM", "ES2022"],
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "noEmit": true,
        "noUncheckedIndexedAccess": true,
        "resolveJsonModule": true,
        "skipLibCheck": true,
        "strict": true,
        "target": "ES2022",
        "types": ["vite/client"]
    },
    "include": ["src", "vite.config.ts"]
}
